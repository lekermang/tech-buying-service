{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET staff_rooms без auth → 401",
      "method": "GET",
      "path": "/?action=staff_rooms",
      "expectedStatus": 401
    },
    {
      "name": "POST send без auth → 401",
      "method": "POST",
      "path": "/?action=send",
      "body": {"room_id": 1, "text": "test"},
      "expectedStatus": 401
    },
    {
      "name": "POST create_invite без auth → 401",
      "method": "POST",
      "path": "/?action=create_invite",
      "body": {"phone": "+79991112233", "name": "Test"},
      "expectedStatus": 401
    },
    {
      "name": "Unknown action → 400",
      "method": "POST",
      "path": "/?action=fake",
      "body": {},
      "expectedStatus": 400
    }
  ]
}
