    { "name": "Convert requires visitor_id", "method": "POST", "path": "/?action=convert", "body": {}, "expectedStatus": 400, "expectedBody": {"error": "string"}, "bodyMatcher": "partial" },
    { "name": "Online requires auth", "method": "GET", "path": "/?action=online", "expectedStatus": 401, "expectedBody": {"error": "string"}, "bodyMatcher": "partial" },
    { "name": "Stats requires auth", "method": "GET", "path": "/?action=stats_today", "expectedStatus": 401, "expectedBody": {"error": "string"}, "bodyMatcher": "partial" },
    { "name": "Search requires auth", "method": "GET", "path": "/?action=search&phone=123", "expectedStatus": 401, "expectedBody": {"error": "string"}, "bodyMatcher": "partial" },
    {
